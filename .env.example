# Copy to a protected file outside the repository and set mode 0600. Never commit credentials.
EUREKA_HOST=127.0.0.1
EUREKA_PORT=9092
# Optional read-only AMI feedback events; AMI must listen on 127.0.0.1:5038.
EUREKA_AMI_ENABLED=false
EUREKA_AMI_USERNAME=
EUREKA_AMI_SECRET=
EUREKA_MAX_CALL_SECONDS=300
EUREKA_INACTIVITY_SECONDS=30
# Enable only for authorized controlled interruption validation; not phone-calibrated.
EUREKA_INTERRUPTION_ENABLED=false
EUREKA_STT_CONFIDENCE=0.70
EUREKA_MAX_CONTEXT_TURNS=3
EUREKA_MAX_TRANSCRIPT_CHARS=500
EUREKA_MAX_RESPONSE_CHARS=420
EUREKA_MODEL_TIMEOUT_SECONDS=15
EUREKA_MAX_MODEL_CHUNKS=128
EUREKA_LOG_DIR=/var/log/eureka
EUREKA_LOG_RETENTION_DAYS=7
EUREKA_PHRASE_DIR=/opt/eureka/phrases
EUREKA_KNOWLEDGE_PATH=/opt/eureka/knowledge/approved-facts-v1.json
EUREKA_PROMPT_PATH=/opt/eureka/prompts/system-v1.txt
# General answers are not fact-checked. Search remains off until separately approved.
EUREKA_GENERAL_KNOWLEDGE_ENABLED=true
EUREKA_WEB_SEARCH_ENABLED=false
# U.S. weather lookups require separate live-request approval and provider mode live.
EUREKA_WEATHER_ENABLED=false
# Identifying User-Agent with operator contact; configure only in the protected environment.
EUREKA_WEATHER_USER_AGENT=
EUREKA_GENERAL_PROMPT_PATH=/opt/eureka/prompts/system-v2-general.txt
# Set live only after approving the named providers and their data handling.
EUREKA_PROVIDER_MODE=disabled
# Live TTS uses ElevenLabs; disabled provider mode makes no live TTS requests.
EUREKA_TTS_PROVIDER=elevenlabs
EUREKA_STT_MODEL=nova-3
# OpenRouter model ID; availability and billing depend on your OpenRouter account.
EUREKA_HAIKU_MODEL=anthropic/claude-haiku-4.5
EUREKA_TTS_MODEL=eleven_turbo_v2_5
EUREKA_TTS_VOICE_ID=
EUREKA_PROVIDER_TIMEOUT_SECONDS=30
EUREKA_STT_ENDPOINTING_MS=500
EUREKA_HAIKU_MAX_TOKENS=256
# Credentials belong only in the protected environment file.
EUREKA_STT_API_KEY=
# OpenRouter API key, not an Anthropic API key.
EUREKA_HAIKU_API_KEY=
EUREKA_TTS_API_KEY=
